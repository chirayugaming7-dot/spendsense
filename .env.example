# SpendSense Local Environment Variables
# Copy this file to .env and insert your Groq Cloud API key to activate AI Analyst capabilities.

VITE_GROQ_API_KEY=your_groq_api_key_here
# Optional model override (default: openai/gpt-oss-120b. Other options: qwen/qwen3.8-27b)
VITE_GROQ_MODEL=openai/gpt-oss-120b
